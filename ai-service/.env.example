# CareerOS AI Service — environment template.
# Copy to `.env` for local runs. All keys use the AI_ prefix (see app/config/settings.py).
# Never commit a real .env — secrets stay out of version control.

AI_APP_NAME=careeros-ai-service
AI_ENVIRONMENT=dev
AI_HOST=0.0.0.0
AI_PORT=8000

# Service-to-service shared secret forwarded by the AI Gateway. Leave blank to disable
# validation in local dev (validation is deferred in the skeleton).
AI_API_KEY=

# AI provider (placeholders — no provider is initialised until agents are implemented).
AI_OPENAI_API_KEY=
AI_DEFAULT_MODEL=gpt-4o
AI_REQUEST_TIMEOUT_SECONDS=60

# Vector store endpoint for RAG (placeholder).
AI_VECTOR_STORE_URL=
