<?xml version="1.0" encoding="UTF-8"?>
<!--
  CareerOS AI logging configuration.

  - Local/dev: human-readable console pattern including the request trace id (MDC: traceId).
  - prod: structured single-line JSON-ish pattern suited to log shippers (ELK / CloudWatch).
  The trace id is populated per request by CorrelationIdFilter and ties log lines to API responses.
-->
<configuration scan="true" scanPeriod="30 seconds">

    <property name="LOG_PATTERN_CONSOLE"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] [traceId=%X{traceId:-}] %cyan(%logger{36}) - %msg%n"/>
    <property name="LOG_PATTERN_PROD"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] [traceId=%X{traceId:-}] %logger{36} - %msg%n"/>

    <springProfile name="dev,test">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${LOG_PATTERN_CONSOLE}</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${LOG_PATTERN_PROD}</pattern>
            </encoder>
        </appender>
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>
