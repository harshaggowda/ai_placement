# =============================================================================
# CareerOS AI — environment template for docker compose.
# Copy to infrastructure/docker/.env (compose reads its sibling .env) and fill secrets.
#   cp .env.example infrastructure/docker/.env
# Never commit a real .env — it is gitignored.
# =============================================================================

# ---- Runtime profile (dev | prod) ----
SPRING_PROFILES_ACTIVE=dev

# ---- Shared database credentials (each service still has its OWN database) ----
DB_USERNAME=careeros
DB_PASSWORD=careeros

# ---- Security ----
# Base64 / long random secret for signing JWTs. Generate one per environment.
JWT_SECRET=

# ---- AI ----
# Shared service-to-service key: AI Gateway -> FastAPI AI service.
AI_SERVICE_API_KEY=
# Model provider key, injected into the FastAPI AI service (not yet used).
OPENAI_API_KEY=

# ---- Payments (Stripe) ----
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- pgAdmin ----
PGADMIN_EMAIL=admin@careeros.local
PGADMIN_PASSWORD=admin
